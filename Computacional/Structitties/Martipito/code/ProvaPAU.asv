%% PART I - BEAM MODELLING
% Martí Gay
% Pau Cornudella
%--------------------
clear; close all;clc;
%--------------------

%% OPCIONES DEL PROBLEMA

problem_type = 1;   % 1 = flexión (fuerza vertical en la punta), 2 = torsión (momento en la punta)
Nm = 6;             % número de modos propios a calcular

%% DATOS DE MATERIAL Y SECCIÓN

E = 71e9;           % Módulo de Young [Pa]
nu = 0.33;          % Coeficiente de Poisson [-]
G = E/(2*(1+nu));   % Módulo cortante [Pa]
rho = 2300;         % Densidad [kg/m^3]

A  = 0.0062;        % Área de la sección [m^2]
Iy = 8.801e-6;      % Momento de inercia respecto a y [m^4]
Iz = 8.069e-5;      % Momento de inercia respecto a z [m^4]
J  = 8.949e-5;      % Módulo de torsión [m^4]

ky = 0.5457;        % factor de cortante en dirección y
kz = 0.1767;        % factor de cortante en dirección z
kt = 0.2920;        % factor de corrección en torsión

%% CARGA DE LA MALLA (NODOS Y ELEMENTOS)

% Cargamos el archivo 'beam.mat' que contiene:
%   xn : matriz de coordenadas nodales [N_nodes x 3]
%   Tn : conectividades de elementos [N_elements x 2]
%   Tm : "material" de cada elemento [N_elements x 1] (aquí solo 1 tipo)
load('beam.mat','xn','Tn','Tm');

N_nodes    = size(xn,1);   % número total de nodos
N_elements = size(Tn,1);   % número total de elementos

%% CONDICIONES DE CONTORNO (DESPLAZAMIENTOS PRESCRITOS)

% Cada fila: [valor_prescrito  nº_nodo  nº_DOF]
% DOFs por nodo: 1:ux, 2:uy, 3:uz, 4:θx, 5:θy, 6:θz
% Aquí: empotramos completamente el nodo 1 (los 6 DOFs a 0)
Up = [0 1 1;
      0 1 2;
      0 1 3;
      0 1 4;
      0 1 5;
      0 1 6];

%% CARGAS CONCENTRADAS

% Cada fila de Fe: [valor  nº_nodo  nº_DOF]
% Aplicamos una carga en la punta (último nodo)
switch problem_type
    case 1
        % Flexión: fuerza vertical (u_z) en el último nodo
        Fe = [1 N_nodes 3];   % 1 N, nodo N_nodes, DOF 3 (uz)
    case 2
        % Torsión: momento alrededor de x (θ_x) en el último nodo
        Fe = [1 N_nodes 4];   % 1 Nm, nodo N_nodes, DOF 4 (θx)
end

%% ORIENTACIÓN LOCAL DE LA VIGA

% Vector j de referencia para orientar el eje local "y" de la viga.
% Aquí lo tomamos simplemente hacia el eje global Y (0,1,0).
j_orientations = [0 1 0];  % mismo para todos los elementos

%% VECTORES DE PROPIEDADES (POR SI HUBIERA VARIOS MATERIALES)

% En este ejemplo solo hay un material y una sección,
% pero lo dejamos en forma de vector por si se extiende.
E_vector  = E;
G_vector  = G;
A_vector  = A;
Iy_vector = Iy;
Iz_vector = Iz;
J_vector  = J;
ky_vector = ky;
kz_vector = kz;
kt_vector = kt;
rho_vector = rho;

%% ENSAMBLAJE DE MATRICES GLOBALES K Y M

Ndof = 6 * N_nodes;        % nº total de grados de libertad
K = zeros(Ndof,Ndof);      % matriz de rigidez global [Ndof x Ndof]
M = zeros(Ndof,Ndof);      % matriz de masa global [Ndof x Ndof]

% Bucle sobre todos los elementos
for e = 1:N_elements
    
    %-------------------------------------------------
    % 1) OBTENER NODOS DEL ELEMENTO Y SU GEOMETRÍA
    %-------------------------------------------------
    node1 = Tn(e,1);           % nodo inicial del elemento
    node2 = Tn(e,2);           % nodo final del elemento
    
    x1 = xn(node1,:);          % coordenadas del nodo 1 [x y z]
    x2 = xn(node2,:);          % coordenadas del nodo 2 [x y z]
    
    v = x2 - x1;               % vector del elemento en global
    L = norm(v);               % longitud del elemento
    
    %-------------------------------------------------
    % 2) SISTEMA DE COORDENADAS LOCAL (i, j, k)
    %-------------------------------------------------
    i_vec = (v / L).';                  % eje local x (columna 3x1)
    
    j_ref = j_orientations.';          % vector de referencia (0,1,0)^T
    j_ref = j_ref / norm(j_ref);       % lo normalizamos
    
    k_vec = cross(i_vec, j_ref);       % eje local z = i × j
    k_vec = k_vec / norm(k_vec);       % normalizamos k
    
    j_vec = cross(k_vec, i_vec);       % eje local y corregido = k × i
    
    %-------------------------------------------------
    % 3) MATRIZ DE ROTACIÓN 3x3 Y AMPLIACIÓN A 12x12
    %-------------------------------------------------
    Rp = [i_vec, j_vec, k_vec];        % matriz 3x3: columnas = ejes locales
    
    % Rotación para 1 nodo (6 DOF: 3 despl + 3 giros)
    Rp6 = [Rp         zeros(3,3);      % traslaciones
           zeros(3,3) Rp       ];      % rotaciones
    
    % Rotación para el elemento completo (2 nodos = 12 DOF)
    Re = blkdiag(Rp6, Rp6);            % matriz 12x12
    
    %-------------------------------------------------
    % 4) MATRICES DE RIGIDEZ DEL ELEMENTO EN COORD. LOCALES
    %    (FORMULACIÓN Timoshenko MUY resumida: axial, flexión,
    %     cortante y torsión. Usamos tu misma estructura Ba, Bb, Bs, Bt)
    %-------------------------------------------------
    
    % Recuperamos propiedades del "material" del elemento (aquí todo 1)
    mat_id = Tm(e,1);                  % índice de material
    E_e  = E_vector(mat_id);
    G_e  = G_vector(mat_id);
    A_e  = A_vector(mat_id);
    Iy_e = Iy_vector(mat_id);
    Iz_e = Iz_vector(mat_id);
    J_e  = J_vector(mat_id);
    ky_e = ky_vector(mat_id);
    kz_e = kz_vector(mat_id);
    kt_e = kt_vector(mat_id);
    rho_e = rho_vector(mat_id);
    
    % ------- AXIAL (Ka) -------
    % Deformación axial ~ derivada de desplazamiento axial
    Nx = [-1/L, 1/L];                  % derivadas de las funciones de forma
    Ba = [Nx(1) 0     0     0 0 0  Nx(2) 0     0     0 0 0];  % 1x12
    Ca = E_e * A_e;                    % rigidez axial EA
    Ka = L * (Re.' * (Ba.' * Ca * Ba) * Re);  % 12x12
    
    % ------- FLEXIÓN (Kb) -------
    % Matriz Bb: relaciona curvaturas con giros (simplificación)
    Bb = [ 0 0 0  0 Nx(1) 0  0 0 0  0 Nx(2) 0 ;   % flexión en un plano
           0 0 0  0 0 Nx(1) 0 0 0  0 0 Nx(2) ];  % flexión en otro plano
    
    Cb = E_e * [Iy_e 0;                    % rigidez flexión
                0    Iz_e];
    
    Kb = L * (Re.' * (Bb.' * Cb * Bb) * Re);  % 12x12
    
    % ------- CORTANTE (Ks) -------
    % Muy simplificado usando un solo punto de Gauss "N_Gauss"
    N_Gauss = 0.5;                         % valor simple (no crítico aquí)
    Bs = [0 Nx(1) 0  0 0 -N_Gauss  0 Nx(2) 0  0 0 -N_Gauss;  % cortante
          0 0 Nx(1) 0 N_Gauss 0    0 0 Nx(2) 0 N_Gauss 0];
    
    Cs = G_e * A_e * [ky_e 0;              % rigidez cortante
                      0    kz_e];
    
    Ks = L * (Re.' * (Bs.' * Cs * Bs) * Re);  % 12x12
    
    % ------- TORSIÓN (Kt) -------
    Bt = [0 0 0 Nx(1) 0 0  0 0 0 Nx(2) 0 0];  % relación torsión-curvatura
    Ct = G_e * J_e * kt_e;                    % rigidez torsión
    Kt = L * (Re.' * (Bt.' * Ct * Bt) * Re);  % 12x12
    
    % Rigidez total del elemento
    Ke = Ka + Kb + Ks + Kt;                   % 12x12
    
    %-------------------------------------------------
    % 5) MATRIZ DE MASA DEL ELEMENTO (CONSISTENTE)
    %    Usamos integración numérica sencilla con 2 puntos de Gauss.
    %-------------------------------------------------
    
    % Matriz de densidades equivalentes (masa por desplazamiento/rotación)
    rho_mat = rho_e * [ A_e 0   0   0   0    0;
                        0   A_e 0   0   0    0;
                        0   0   A_e 0   0    0;
                        0   0   0   J_e 0    0;
                        0   0   0   0   Iy_e 0;
                        0   0   0   0   0    Iz_e ];
    
    % Puntos de Gauss y pesos para integrar en el elemento
    Xi = [-1/sqrt(3); 1/sqrt(3)];       % coordenadas en el elemento
    w  = [1; 1];                        % pesos
    
    Me = zeros(12,12);                  % inicializamos masa del elemento
    
    % Integramos suma(w * N' * rho_mat * N) * L/2
    for k = 1:2
        
        % Funciones de forma lineales en 1D
        N1 = (1 - Xi(k))/2;
        N2 = (1 + Xi(k))/2;
        
        % Matriz de forma 6x12 (tres despl + tres giros en dos nodos)
        Nmat = [N1 0  0  0  0  0  N2 0  0  0  0  0;
                0  N1 0  0  0  0  0  N2 0  0  0  0;
                0  0  N1 0  0  0  0  0  N2 0  0  0;
                0  0  0  N1 0  0  0  0  0  N2 0  0;
                0  0  0  0  N1 0  0  0  0  0  N2 0;
                0  0  0  0  0  N1 0  0  0  0  0  N2];
        
        % Aportación de este punto de Gauss a la matriz de masa
        Me = Me + (w(k) * L / 2) * (Re.' * (Nmat.' * rho_mat * Nmat) * Re);
    end
    
    %-------------------------------------------------
    % 6) ENSAMBLAJE A MATRICES GLOBALES
    %-------------------------------------------------
    
    % Vector de índices globales de los 12 DOFs del elemento
    Idof = zeros(12,1);                 % inicializamos
    for j = 1:6                          % 6 DOFs por nodo
        Idof(j)   = 6*(node1-1) + j;    % DOFs del nodo 1
        Idof(6+j) = 6*(node2-1) + j;    % DOFs del nodo 2
    end
    
    % Sumar rigidez y masa del elemento a las matrices globales
    K(Idof,Idof) = K(Idof,Idof) + Ke;
    M(Idof,Idof) = M(Idof,Idof) + Me;
end

%% VECTOR DE FUERZAS GLOBAL (SOLO FUERZAS CONCENTRADAS)

f = zeros(Ndof,1);                      % vector de fuerzas global

% Rellenamos f a partir de Fe
for q = 1:size(Fe,1)
    valor = Fe(q,1);                    % magnitud de la fuerza
    nodo  = Fe(q,2);                    % nodo donde se aplica
    dof   = Fe(q,3);                    % DOF local (1..6)
    
    iglob = 6*(nodo-1) + dof;           % índice global del DOF
    f(iglob) = f(iglob) + valor;        % sumamos la fuerza
end

%% APLICAR CONDICIONES DE CONTORNO

u = zeros(Ndof,1);                      % vector de desplazamientos globales

% Lista de DOFs prescritos (Ip) y asignación de sus valores
Ip = zeros(size(Up,1),1);              % inicializamos
for p = 1:size(Up,1)
    valor = Up(p,1);                    % valor impuesto (aquí 0)
    nodo  = Up(p,2);                    % nodo
    dof   = Up(p,3);                    % DOF
    
    iglob = 6*(nodo-1) + dof;           % índice global
    Ip(p) = iglob;                      % guardamos DOF fijo
    u(iglob) = valor;                   % asignamos desplazamiento
end

% DOFs libres = todos los DOFs menos los fijados
todos = 1:Ndof;                         % vector [1 2 ... Ndof]
If = setdiff(todos, Ip);                % DOFs libres

%% RESOLVER PROBLEMA ESTÁTICO

% Sistema reducido: K_ff * u_f = f_f - K_fp * u_p
Kff = K(If,If);                         % submatriz libre-libre
Kfp = K(If,Ip);                         % submatriz libre-fijo
ff  = f(If);                            % fuerzas en DOFs libres
up  = u(Ip);                            % desplazamientos prescritos

% Calculamos u_f
uf = Kff \ (ff - Kfp*up);               % resolución del sistema lineal

% Insertamos u_f en el vector global u
u(If) = uf;                             % completamos el vector de desplazamientos

% Reacciones en apoyos (opcional)
f_reac = K*u - f;                       % reacciones en todos los DOFs

%% ANÁLISIS MODAL

% Queremos resolver: K_ff * phi = lambda * M_ff * phi
Kff = K(If,If);                         % rigidez reducida
Mff = M(If,If);                         % masa reducida

% Usamos eigs para obtener los Nm menores autovalores
% (si hay problema de convergencia se puede usar eig, pero es más caro)
[Vec, D] = eigs(Kff, Mff, Nm, 'SM');    % 'SM' = smallest magnitude

% Inicializamos matrices de modos y frecuencias
Phi   = zeros(Ndof, Nm);               % modos completos (incluye fijados = 0)
lambda = zeros(Nm,1);                  % autovalores
freq   = zeros(Nm,1);                  % frecuencias en Hz

for k = 1:Nm
    
    v_k = Vec(:,k);                    % modo reducido (solo DOFs libres)
    
    % Normalizamos el modo con respecto a la masa: v^T Mff v = 1
    norma_masa = sqrt(v_k' * Mff * v_k);
    v_k = v_k / norma_masa;
    
    % Metemos el modo en el vector global Phi(:,k)
    Phi(If,k) = v_k;                   % DOFs libres
    Phi(Ip,k) = 0;                     % DOFs fijados = 0
    
    % Autovalor correspondiente
    lambda(k) = D(k,k);                % lambda = omega^2
    
    % Frecuencia natural en Hz
    omega = sqrt(lambda(k));           % pulsación [rad/s]
    freq(k) = omega / (2*pi);          % frecuencia [Hz]
end

%% EXTRAER DESPLAZAMIENTOS ÚTILES PARA GRÁFICAS

% Flecha vertical u_z en cada nodo
u_z = zeros(N_nodes,1);
theta_x = zeros(N_nodes,1);

for i = 1:N_nodes
    u_z(i)     = u(3 + 6*(i-1));       % DOF 3 de cada nodo = u_z
    theta_x(i) = u(4 + 6*(i-1));       % DOF 4 de cada nodo = θ_x
end

%% GUARDAR RESULTADOS

save('beam_matrices.mat','K','M');      % guardamos matrices globales
save('beam_results.mat','u','freq','Phi'); % guardamos resultados básicos

%% GRÁFICAS DE RESPUESTA ESTÁTICA

figure;
plot(xn(:,1), u_z, '-o');               % deformada vertical a lo largo de x
grid on;
title('Flecha vertical a lo largo de la envergadura');
xlabel('x (m)');
ylabel('u_z (m)');
switch problem_type
    case 1
        legend('Flexión (carga vertical en punta)','Location','best');
    case 2
        legend('Respuesta con carga de torsión','Location','best');
end

figure;
plot(xn(:,1), theta_x, '-o');           % giro θ_x a lo largo de x
grid on;
title('Ángulo de giro \theta_x a lo largo de la envergadura');
xlabel('x (m)');
ylabel('\theta_x (rad)');
switch problem_type
    case 1
        legend('Flexión (giro por flexión)','Location','best');
    case 2
        legend('Torsión (momento en punta)','Location','best');
end

%% GRÁFICAS DE MODOS (OPCIONAL: SOLO ALGUNOS)

for k = 1:Nm
    % Extraemos u_y, u_z y θ_x del modo k
    u_y_modal    = zeros(N_nodes,1);
    u_z_modal    = zeros(N_nodes,1);
    theta_x_modal = zeros(N_nodes,1);
    
    for i = 1:N_nodes
        u_y_modal(i)     = Phi(2 + 6*(i-1), k);
        u_z_modal(i)     = Phi(3 + 6*(i-1), k);
        theta_x_modal(i) = Phi(4 + 6*(i-1), k);
    end
    
    % Graficamos u_z del modo k
    figure;
    plot(xn(:,1), u_z_modal, '-o');
    grid on;
    title(['Modo ', num2str(k), ' - u_z(x), f = ', num2str(freq(k),'%.2f'), ' Hz']);
    xlabel('x (m)');
    ylabel(['u_z modo ', num2str(k)]);
end



