%% PART I - BEAM MODELLING (TEMPLATE)

% Useful commands to initialize script
clear
close all

%% DATA

type = "bending"; % bending or torsion
Nm = 6;

% Define the problem's data (e.g. dimensions, material properties, etc.)
E = 71e9; %Pa
v_poisson = 0.33;
G = E/(2*(1+v_poisson));
rho = 2300; %kg/m3
c = 0.8; %m
b = 5.5; %m
y0 = 0.3083; %m
y1 = 0.176; %m
y2 = 0.464; %m
h1 = 17.5e-3; %m
h2 = 15e-3; %m
h3 = 6e-3; %m
A = 0.0062; %m2
Iy = 8.801e-6; %m4
Iz = 8.069e-5; %m4
J = 8.949e-5; %m4
ky = 0.5457;
kz = 0.1767;
kt = 0.2920;
yc = 0.2954; %m

%% PREPROCESS
zeros(0,3);
% Load mesh data
load('beam.mat','xn','Tn','Tm');
% xn : Nodal coordinates       
%      |x1 y1 z1|
%      |x2 y2 z2|
%      |  ...   |
% Tn : Nodal connectivities [Nelem x 2]
% Tm : Material connectivities [Nelem x 1]

% Define boundary conditions and forces data matrices: Up, Fe, Qe, Be
N_elements = size(Tn,1);
N_nodes = size(xn,1);
Up = [0 1 1; % displacement, node, dof
      0 1 2;
      0 1 3;
      0 1 4;
      0 1 5;
      0 1 6];

% External forces (force, node, dof)
switch(problem_type)
    case "bending"
    Fe = [1 N_nodes 3];
    case "torsion"
    Fe = [1 N_nodes 4];
end

% Distributed forces (force, node, dof)
Qe = [0 1 2];

% Body forces (force, node, dof)
Be = [0 1 2];

j_orientations = [0 1 0]; 

%more rows would be added if more values existed
E_vector = [E]; 
A_vector = [A];  
G_vector = [G];  
Iy_vector = [Iy];  
Iz_vector = [Iz];  
ky_vector = [ky];  
kz_vector = [kz];  
kt_vector = [kt];  
J_vector = [J];  
rho_vector = [rho];  

%% SOLVER

% Obtain system matrices

% TIP: To avoid recomputing the system matrices use a save/load structure:
if 1 % Set to 1 to (re)compute the system matrices and '0' to load them
    
    % Compute system matrices (as long as parameters don't change there is 
    % no need to repeat the matrix assembly on every run)
    N_dof = 6 * N_nodes;
    K = sparse(N_dof, N_dof);
    M = sparse(N_dof, N_dof);

    % Preallocate for speed
    nElem = size(Tn, 1);
    Re = cell(nElem, 1); % store rotation matrices for reuse
    Le = zeros(nElem, 1);

    for e = 1:nElem
        % Nodes of element
        ni = Tn(e,1);
        nj = Tn(e,2);

        % Nodal coordinates
        xi = xn(ni, :);
        xj = xn(nj, :);

        % Element length and direction
        ve = xj - xi;
        Le(e) = norm(ve);
        x_dir = ve / Le(e);

        % Local y reference (from j_orientations)
        y_ref = j_orientations / norm(j_orientations);

        % Compute local coordinate system
        z_dir = cross(x_dir, y_ref); z_dir = z_dir / norm(z_dir);
        y_dir = cross(z_dir, x_dir);

        % Rotation matrix (3x3)
        Re_local = [x_dir' y_dir' z_dir'];
        Re{e} = Re_local;

        % Get material properties
        mat_id = Tm(e);
        Ee = E_vector(mat_id);
        Ge = G_vector(mat_id);
        Ae = A_vector(mat_id);
        Iye = Iy_vector(mat_id);
        Ize = Iz_vector(mat_id);
        Je = J_vector(mat_id);
        kye = ky_vector(mat_id);
        kze = kz_vector(mat_id);
        kte = kt_vector(mat_id);
        rhoe = rho_vector(mat_id);

        % Local stiffness matrix (Euler-Bernoulli or Timoshenko)
        [Ke_local, Me_local] = beamElementMatrices(Ee, Ge, Ae, Iye, Ize, Je, kye, kze, kte, rhoe, Le(e));

        % Transform to global coordinates
        R = blkdiag(Re_local, Re_local, Re_local, Re_local); % 12x12
        Ke_global = R' * Ke_local * R;
        Me_global = R' * Me_local * R;

        % Global DOFs
        dof = [(ni-1)*6 + (1:6), (nj-1)*6 + (1:6)];

        % Assembly
        K(dof, dof) = K(dof, dof) + Ke_global;
        M(dof, dof) = M(dof, dof) + Me_global;
    end
    
    % Once (re)computed, save them to a separate data file
    save('beam_matrices.mat','K','M'); 
    % TIP: Add other potential results that can be reused in other parts
    % (e.g. element's length 'l', elements rotations matrices 'R', etc.)
    
else
    
    % Load previously computed results
    load('beam_matrices.mat','K','M');
    
end

fprintf('--- Applying boundary conditions and loads ---\n');

% --- External Force Vector ---
F = zeros(N_dof, 1);
F_node = Fe(1,2);
F_dof = Fe(1,3);
F_global = (F_node - 1) * 6 + F_dof;
F(F_global) = Fe(1,1); % apply unit or specified load

% --- Apply Boundary Conditions ---
prescribed_dofs = (Up(:,2) - 1) * 6 + Up(:,3);
free_dofs = setdiff(1:N_dof, prescribed_dofs);

% --- Solve system ---
U = zeros(N_dof, 1);
U(free_dofs) = K(free_dofs, free_dofs) \ F(free_dofs);

fprintf('--- Static solution complete ---\n');

% Perform modal analysis
fprintf('--- Performing modal analysis ---\n');
n_modes = min(Nm, length(free_dofs));
[Phi, Omega2] = eigs(K(free_dofs, free_dofs), M(free_dofs, free_dofs), n_modes, 'sm');
frequencies = sqrt(diag(Omega2)) / (2*pi);

fprintf('Natural frequencies [Hz]:\n');
disp(frequencies');

% Compute external forces vector
% ...

% Solve system
% ...

%% POSTPROCESS

% Save data for postprocessing in separate script file (useful when results
% from different runs need to be compared)
save('beam_results.mat');

% Include plot functions
% ...

function [Ke, Me] = beamElementMatrices(E, G, A, Iy, Iz, J, ky, kz, kt, rho, L)
% Computes local stiffness and consistent mass matrices for a 3D Timoshenko beam

% Stiffness (simplified generic form)
EA_L = E*A/L;
GJ_L = G*J/L;

% Axial and torsional
K_ax = [ EA_L -EA_L; -EA_L EA_L ];
K_tor = [ GJ_L -GJ_L; -GJ_L GJ_L ];

% Placeholder 12x12 (replace with your full beam formulation)
Ke = zeros(12);
Ke(1,1)=EA_L; Ke(1,7)=-EA_L; Ke(7,1)=-EA_L; Ke(7,7)=EA_L;
Ke(4,4)=GJ_L; Ke(4,10)=-GJ_L; Ke(10,4)=-GJ_L; Ke(10,10)=GJ_L;

% Mass matrix (lumped approximation)
m = rho * A * L;
Me = (m/2) * eye(12);
Me(7:end,7:end) = (m/2) * eye(6);
end
