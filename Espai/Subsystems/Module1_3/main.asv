clear; clc; close all;

% Definición de los subcuerpos

Bodies = []; % Vector de cuerpos vacío
% Bodies = [Bodies, Body("cube", 200, [0; 0; 0], 2, eye(3))];
% Bodies = [Bodies, Body("box", 50, [3; 0; 0], [4,0.2,2],eye(3))];
% Bodies = [Bodies, Body("box", 50, [-3; 0; 0], [4,0.2,2],eye(3))];

Bodies = [Bodies, Body('box', 190.134,[0;0;0],[208.3, 64.5, 68.6], eye(3))];
Bodies = [Bodies, Body('box', 103.1184,[0;-78.5;0],[78.8, 92.5, 68.6], eye(3))];
Rz = [
    -1,  0,  0;
     0, -1,  0;
     0,  0,  1
];
Rx = [1 ,0 ,0;
      0, -1, 0;
      0, 0, -1];
Bodies = [Bodies, Body('tri_prism', 42.3738,[-60.9833;-63.0833;0],[64.75,92.5,68.6], Rz)];
Bodies = [Bodies, Body('tri_prism', 42.3738,[60.9833;-63.0833;0],[64.75,92.5,68.6], Rx)];
Bodies = [Bodies, Body('cil', 50, [0,-267,0], [0.2, 110.1]), eye(3)];

% Calculamos CG global

total_mass = sum([Bodies.mass]);
r_cg_total = [0; 0; 0];

for i = 1:length(Bodies)
    r_cg_total = r_cg_total + Bodies(i).mass * Bodies(i).r_cg;
end
r_cg_total = r_cg_total / total_mass;

fprintf('Centro de gravedad global [m]: (%.3f, %.3f, %.3f)\n', ...
       r_cg_total(1), r_cg_total(2), r_cg_total(3));


% Calculamos del tensor de inercia total respecto al CG global

I_total = zeros(3,3);
for i = 1:length(Bodies)
    I_total = I_total + Bodies(i).inertiaAtRef(r_cg_total);
end

disp('Tensor de inercia total respecto al CG global [kg·m²]:');
disp(I_total);

hold on;
axis equal;
grid on;
view(3);
xlabel('X (m)');
ylabel('Y (m)');
zlabel('Z (m)');
title('Satellite Geometry');
plot_satellite(Bodies,gca)



